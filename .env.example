# ====================================================================
# SQLSense AI - Docker Environment Configuration
# ====================================================================

# Port mapping on host machine
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Backend service configurations
HOST=0.0.0.0
PORT=8000

# Frontend API URL configuration:
# Leave empty for Nginx reverse-proxy mode (recommended for Docker Compose)
# Or specify explicit backend URL (e.g. http://localhost:8000 or https://api.yourdomain.com)
VITE_API_URL=

# Optional: Google Gemini API Key (if external LLM mode is enabled in future)
GEMINI_API_KEY=
